lib/generated_plugin_registrant.dart

# Coverage
coverage/

# Build output (root and platform folders)
build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Avoid committing generated JavaScript files:
*.dart.js
*.info.json
*.js_
*.js.deps
*.js.map
# NOTE: the generic `*.js` rule from the dart template is intentionally
# omitted so that hand-written JS (e.g. for the web platform) is not ignored.

